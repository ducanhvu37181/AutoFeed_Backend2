using AutoFeed_Backend_DAO.Models;
using AutoFeed_Backend_Repositories.BasicRepo;
using AutoFeed_Backend_Repositories.UnitOfWork;
using AutoFeed_Backend_Services.Interfaces;
using Microsoft.EntityFrameworkCore;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using System;

namespace AutoFeed_Backend_Services.Services;

public class ScheduleService : IScheduleService
{
    private readonly IUnitOfWork _uow;

    public ScheduleService(IUnitOfWork uow)
    {
        _uow = uow;
    }

    public async Task<Schedule?> CreateAsync(Schedule model)
    {
        if (model.UserId == null || model.StartDate == null || model.EndDate == null) return null;
        if (model.EndDate < model.StartDate) return null;

        // Check overlap using DbContext for efficiency
        var overlap = await _uow.Context.Schedules.AnyAsync(s => s.UserId == model.UserId
            && s.StartDate != null && s.EndDate != null
            && s.StartDate <= model.EndDate && s.EndDate >= model.StartDate);

        if (overlap) return null;

        var repo = _uow.Repository<Schedule>();
        model.SchedId = 0;
        model.CreatedDate = System.DateTime.UtcNow;
        await repo.CreateAsync(model);
        return model;
    }

    public async Task<bool> DeleteAsync(int id)
    {
        var repo = _uow.Repository<Schedule>();
        var existing = await repo.GetByIdAsync(id);
        if (existing == null) return false;
        return await repo.RemoveAsync(existing);
    }

    public async Task<List<Schedule>> GetAllAsync()
    {
        var repo = _uow.Repository<Schedule>();
        return await repo.GetAllAsync();
    }

    public async Task<Schedule?> GetByIdAsync(int id)
    {
        var repo = _uow.Repository<Schedule>();
        return await repo.GetByIdAsync(id);
    }

    public async Task<bool> UpdateAsync(Schedule model)
    {
        var repo = _uow.Repository<Schedule>();
        var existing = await repo.GetByIdAsync(model.SchedId);
        if (existing == null) return false;

        if (model.UserId == null || model.StartDate == null || model.EndDate == null) return false;
        if (model.EndDate < model.StartDate) return false;

        var overlap = await _uow.Context.Schedules.AnyAsync(s => s.UserId == model.UserId
            && s.SchedId != model.SchedId
            && s.StartDate != null && s.EndDate != null
            && s.StartDate <= model.EndDate && s.EndDate >= model.StartDate);

        if (overlap) return false;

        existing.UserId = model.UserId;
        existing.TaskId = model.TaskId;
        existing.CbarnId = model.CbarnId;
        existing.Description = model.Description;
        existing.Status = model.Status;
        existing.StartDate = model.StartDate;
        existing.EndDate = model.EndDate;

        await repo.UpdateAsync(existing);
        return true;
    }
}
